@model List<Product>
@{ViewData["Title"]="Handmade Luxury";}
<section class="hero row align-items-center rounded-5 overflow-hidden"><div class="col-md-7 p-5"><span class="eyebrow">HANDMADE • PERSONALIZED • TIMELESS</span><h1 class="display-3 serif mt-3">Little things,<br/><em>made with love.</em></h1><p class="lead my-4">Crochet treasures, designed by you and handcrafted for your special moments.</p><a class="btn btn-gold btn-lg" asp-controller="Shop" asp-action="Index">Explore Collection →</a></div><div class="col-md-5 hero-art text-center py-5">🧶<div class="small mt-3">CRAFTED JUST FOR YOU</div></div></section>
<div class="text-center my-5"><span class="eyebrow">THE COLLECTION</span><h2 class="serif display-6">Your next favorite thing</h2></div><div class="row g-4">@foreach(var p in Model){<div class="col-md-3 col-sm-6"><div class="product-card h-100"><div class="product-art">@p.Emoji</div><div class="p-3"><div class="text-muted small">@p.Category</div><h5>@p.Name</h5><div class="d-flex justify-content-between align-items-center"><strong>From ₹@p.BasePrice</strong><a asp-controller="Design" asp-action="Create" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark">Customize →</a></div></div></div></div>}</div>