@model CheckoutVm
@{var d=(Design)ViewBag.Design;ViewData["Title"]="Checkout";}
<div class="row g-4"><div class="col-lg-7"><div class="panel"><h1 class="serif">Checkout</h1><form asp-action="Checkout" method="post"><input asp-for="DesignId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><label asp-for="ShippingAddress" class="form-label">Delivery Address</label><textarea asp-for="ShippingAddress" class="form-control mb-3" rows="3"></textarea><label asp-for="Phone" class="form-label">Mobile Number</label><input asp-for="Phone" class="form-control mb-3" placeholder="10-digit mobile"/><p class="small text-muted">Payment method: Cash on Delivery (demo; no online payment).</p><button class="btn btn-gold w-100">Place Custom Order</button></form></div></div><div class="col-lg-5"><div class="panel"><h3 class="serif">Order Summary</h3><h5>@d.Product?.Name</h5><p>@d.Color · @d.Size · @d.Pattern</p><p>Personalization: @d.PersonalName</p><p>Quantity: @d.Quantity</p><hr/><h3>₹@(d.UnitPrice*d.Quantity)</h3></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }