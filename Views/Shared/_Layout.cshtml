<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · CrochetCraft</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><nav class="navbar navbar-expand-lg navbar-light shadow-sm sticky-top"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">✿ CrochetCraft<span class="brand-dot">.</span></a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">Shop</a></li>@if(Context.Session.GetInt32("UserId")!=null){<li class="nav-item"><a class="nav-link" asp-controller="Design" asp-action="Mine">My Designs</a></li><li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="Mine">My Orders</a></li>@if(Context.Session.GetString("Role")=="Admin"){<li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>}<li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-dark btn-sm">Logout</button></form></li>}else{<li class="nav-item"><a class="btn btn-outline-dark btn-sm" asp-controller="Account" asp-action="Login">Login</a></li><li class="nav-item"><a class="btn btn-gold btn-sm" asp-controller="Account" asp-action="Register">Join Us</a></li>}</ul></div></div></nav><main class="container py-5">@if(TempData["Message"]!=null){<div class="alert alert-success">@TempData["Message"]</div>}@RenderBody()</main><footer class="py-4 text-center"><div class="container">Handmade with love · CrochetCraft © @DateTime.Now.Year</div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>