@model LoginVm
@{ViewData["Title"]="Sign In";}
<div class="form-shell"><h1 class="serif">Welcome back</h1><p class="text-muted">Sign in to continue your crochet journey.</p><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Email"></label><input asp-for="Email" class="form-control mb-2"/><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password"></label><input asp-for="Password" class="form-control mb-3"/><span asp-validation-for="Password" class="text-danger"></span><button class="btn btn-gold w-100">Sign In</button></form><p class="mt-3">New here? <a asp-action="Register">Create account</a></p></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }