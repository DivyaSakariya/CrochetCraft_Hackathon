@model DesignVm
@{var p=(Product)ViewBag.Product;ViewData["Title"]="Design Studio";}
<div class="text-center mb-4"><span class="eyebrow">THE DESIGN STUDIO</span><h1 class="serif display-5">Make it yours</h1><p class="text-muted">Design your @p.Name with your favorite details.</p></div><div class="row g-4"><div class="col-lg-6"><div class="panel"><form asp-action="Create" method="post" id="designForm"><input asp-for="ProductId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Yarn Color</label><select asp-for="Color" class="form-select"><option>Rose</option><option>Lavender</option><option>Cream</option><option>Sage</option><option>Sky</option></select></div><div class="col-md-6"><label class="form-label">Size</label><select asp-for="Size" class="form-select"><option>Small</option><option selected>Medium</option><option>Large</option></select></div><div class="col-md-6"><label class="form-label">Pattern</label><select asp-for="Pattern" class="form-select"><option>Classic</option><option>Heart</option><option>Flower</option><option>Star</option></select></div><div class="col-md-6"><label class="form-label">Quantity</label><input asp-for="Quantity" class="form-control" min="1" max="100"/></div><div class="col-12"><label class="form-label">Personalized Name (optional)</label><input asp-for="PersonalName" class="form-control" maxlength="40" placeholder="Your name or message"/></div><div class="col-12"><div class="form-check"><input asp-for="Bow" class="form-check-input"/><label asp-for="Bow" class="form-check-label">Add a bow (+₹20)</label></div><div class="form-check"><input asp-for="GiftWrap" class="form-check-input"/><label asp-for="GiftWrap" class="form-check-label">Premium gift wrap (+₹35)</label></div></div></div><button class="btn btn-gold btn-lg w-100 mt-4">Save Design & Checkout →</button></form></div></div><div class="col-lg-6"><div class="panel preview-panel text-center" id="preview" data-base="@p.BasePrice" data-yarn="@p.YarnGrams"><span class="eyebrow">LIVE 2D DESIGN PREVIEW</span><div id="previewArt" class="preview-art"><span id="previewEmoji">@p.Emoji</span><div id="previewPattern" class="pattern-badge">Classic</div></div><h3 class="serif">@p.Name</h3><div id="previewName" class="text-muted mb-2">Your custom creation</div><div class="small" id="previewExtras"></div><hr/><p class="mb-1">Estimated Total</p><h2 id="totalPrice">₹@p.BasePrice</h2><p class="text-muted small" id="yarnEstimate"></p><small class="text-muted">Illustrative color preview, not an exact product photograph.</small></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> <script src="~/js/designer.js" asp-append-version="true"></script> }