@model List<Design>
@{ViewData["Title"]="My Designs";}
<h1 class="serif mb-4">My saved designs</h1><div class="row g-3">@foreach(var d in Model){<div class="col-md-6"><div class="panel"><h4>@d.Product?.Emoji @d.Product?.Name</h4><p>@d.Color · @d.Size · @d.Pattern · @d.PersonalName</p><p>Quantity: @d.Quantity · Yarn estimate: @d.YarnRequiredGrams g</p><strong>₹@(d.UnitPrice*d.Quantity)</strong><div class="mt-3"><a class="btn btn-gold btn-sm" asp-controller="Orders" asp-action="Checkout" asp-route-id="@d.Id">Checkout / View Order</a></div></div></div>}</div>@if(!Model.Any()){<p>No designs yet. <a asp-controller="Shop" asp-action="Index">Start designing!</a></p>}