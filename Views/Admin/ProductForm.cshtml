@model Product
@{ViewData["Title"]="Product Editor";}
<div class="form-shell wide"><h1 class="serif">@(Model.Id==0?"Add Product":"Edit Product")</h1><form asp-action="ProductForm" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Name"></label><input asp-for="Name" class="form-control mb-2"/><label asp-for="Category"></label><select asp-for="Category" class="form-select mb-2"><option>Keychain</option><option>Bouquet</option><option>Bag</option><option>Plushie</option></select><label asp-for="BasePrice">Base Price (₹)</label><input asp-for="BasePrice" class="form-control mb-2" type="number" step="0.01"/><label asp-for="YarnGrams">Yarn per item (g)</label><input asp-for="YarnGrams" class="form-control mb-2" type="number" step="0.01"/><label asp-for="Emoji"></label><input asp-for="Emoji" class="form-control mb-2"/><label asp-for="Description"></label><textarea asp-for="Description" class="form-control mb-2"></textarea><div class="form-check mb-3"><input asp-for="Active" class="form-check-input"/><label asp-for="Active" class="form-check-label"></label></div><button class="btn btn-gold">Save Product</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }