@model List<Material>
@{ViewData["Title"]="Yarn Inventory";}
<div class="d-flex justify-content-between mb-3"><h1 class="serif">Yarn Inventory</h1><a class="btn btn-gold" asp-action="MaterialForm">+ Add Material</a></div><div class="panel table-responsive"><table class="table"><thead><tr><th>Material</th><th>Stock (g)</th><th>Reorder At (g)</th><th>Alert</th><th>Actions</th></tr></thead><tbody>@foreach(var m in Model){<tr><td>@m.Name</td><td>@m.StockGrams</td><td>@m.ReorderLevel</td><td>@if(m.StockGrams<=m.ReorderLevel){<span class="badge bg-danger">Low stock</span>}else{<span class="badge bg-success">Healthy</span>}</td><td><a class="btn btn-sm btn-outline-dark" asp-action="MaterialForm" asp-route-id="@m.Id">Edit</a><form asp-action="DeleteMaterial" method="post" class="d-inline"><input type="hidden" name="id" value="@m.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete material?')">Delete</button></form></td></tr>}</tbody></table></div>