@model List<CraftOrder>
@{ViewData["Title"]="Manage Orders";}
<h1 class="serif mb-4">Customer Orders</h1><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>#</th><th>Customer</th><th>Contact</th><th>Design</th><th>Total</th><th>Update Status</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.Id</td><td>@o.User?.Name<br/><small>@o.User?.Email</small></td><td>@o.Phone<br/><small>@o.ShippingAddress</small></td><td>@o.Design?.Product?.Name<br/><small>@o.Design?.Color, @o.Design?.Size, @o.Design?.Pattern<br/>Name: @o.Design?.PersonalName · Qty: @o.Design?.Quantity<br/>Bow: @o.Design?.Bow · Gift wrap: @o.Design?.GiftWrap</small></td><td>₹@o.Total</td><td><form asp-action="Status" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@o.Id"/><select class="form-select form-select-sm" name="status">@foreach(var s in new[]{"Pending","Making","Ready","Delivered","Cancelled"}){if(s==o.Status){<option selected>@s</option>}else{<option>@s</option>}}</select><button class="btn btn-gold btn-sm">Save</button></form></td></tr>}</tbody></table></div>