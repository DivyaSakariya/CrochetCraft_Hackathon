@model Material
@{ViewData["Title"]="Material Editor";}
<div class="form-shell wide"><h1 class="serif">Material Details</h1><form asp-action="MaterialForm" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Name"></label><input asp-for="Name" class="form-control mb-3"/><label asp-for="StockGrams">Stock in Grams</label><input asp-for="StockGrams" type="number" step="0.01" class="form-control mb-3"/><label asp-for="ReorderLevel">Low Stock Threshold (g)</label><input asp-for="ReorderLevel" type="number" step="0.01" class="form-control mb-3"/><button class="btn btn-gold">Save Material</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }