@model List<Product>
@{ViewData["Title"]="Manage Products";}
<div class="d-flex justify-content-between mb-3"><h1 class="serif">Products</h1><a class="btn btn-gold" asp-action="ProductForm">+ Add Product</a></div><div class="panel table-responsive"><table class="table"><thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Yarn</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Emoji @p.Name</td><td>@p.Category</td><td>₹@p.BasePrice</td><td>@p.YarnGrams g</td><td>@(p.Active?"Active":"Hidden")</td><td><a class="btn btn-sm btn-outline-dark" asp-action="ProductForm" asp-route-id="@p.Id">Edit</a><form class="d-inline" asp-action="DeleteProduct" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hide this product?')">Hide</button></form></td></tr>}</tbody></table></div>