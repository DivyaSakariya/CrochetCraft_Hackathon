@model List<CraftOrder>
@{ViewData["Title"]="Admin Dashboard";}
<h1 class="serif">Seller Dashboard</h1><p class="text-muted">Your handmade business at a glance.</p><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card">Customers<h2>@ViewBag.Customers</h2></div></div><div class="col-md-4"><div class="stat-card">Order value (not paid revenue)<h2>₹@ViewBag.Revenue</h2></div></div><div class="col-md-4"><div class="stat-card">Low-stock materials<h2>@ViewBag.LowStock</h2></div></div></div><div class="d-flex gap-2 flex-wrap mb-4"><a class="btn btn-gold" asp-action="Products">Manage Products</a><a class="btn btn-outline-dark" asp-action="Orders">Manage Orders</a><a class="btn btn-outline-dark" asp-action="Materials">Yarn Inventory</a></div><div class="panel"><h3 class="serif">Recent Orders</h3><table class="table"><thead><tr><th>#</th><th>Customer</th><th>Item</th><th>Total</th><th>Status</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.Id</td><td>@o.User?.Name</td><td>@o.Design?.Product?.Name</td><td>₹@o.Total</td><td>@o.Status</td></tr>}</tbody></table></div>