@model List<Product>
@{ViewData["Title"]="Shop";}
<div class="text-center mb-5"><span class="eyebrow">HANDMADE COLLECTION</span><h1 class="serif display-5">Find your perfect piece</h1><p class="text-muted">Every item can be made uniquely yours.</p></div><div class="mb-4 d-flex gap-2 flex-wrap"><a class="btn btn-outline-dark btn-sm" asp-action="Index">All</a>@foreach(var c in new[]{"Keychain","Bouquet","Bag","Plushie"}){<a class="btn btn-outline-dark btn-sm" asp-action="Index" asp-route-category="@c">@c</a>}</div><div class="row g-4">@foreach(var p in Model){<div class="col-lg-3 col-md-4 col-sm-6"><div class="product-card h-100"><div class="product-art">@p.Emoji</div><div class="p-3"><small class="text-muted">@p.Category</small><h5>@p.Name</h5><p class="small text-muted">@p.Description</p><div class="d-flex justify-content-between align-items-center"><strong>₹@p.BasePrice</strong><a class="btn btn-gold btn-sm" asp-controller="Design" asp-action="Create" asp-route-id="@p.Id">Design Yours</a></div></div></div></div>}</div>